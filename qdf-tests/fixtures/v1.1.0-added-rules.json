[
  {
    "id": "app-updater-installer-cache",
    "category": "下载与安装包",
    "name": "更新器残留安装包",
    "description": "electron-updater 更新完成后残留的安装包：目录名以 -updater 结尾、内容只有 installer.exe（本机实测 7 个共约 1.5 GB）。删除后下次更新会重新下载，故移入回收站、默认不勾选、仅清理 30 天前的。",
    "kind": "cleanup",
    "risk": "careful",
    "action": "recycle",
    "defaultSelected": false,
    "pathTemplates": [
      "%LOCALAPPDATA%\\*-updater"
    ],
    "filePatterns": [
      "*.exe"
    ],
    "recurse": false,
    "minAgeDays": 30
  },
