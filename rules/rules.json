{
  "schemaVersion": 1,
  "largeFileThresholdBytes": 1073741824,
  "rules": [
    {
      "id": "user-temp",
      "category": "系统与用户项",
      "name": "用户临时文件",
      "description": "清理 7 天未修改的当前用户临时文件，正在使用的文件会自动跳过。",
      "kind": "cleanup",
      "risk": "safe",
      "action": "delete",
      "defaultSelected": true,
      "pathTemplates": [
        "%TEMP%"
      ],
      "filePatterns": [
        "*"
      ],
      "recurse": true,
      "minAgeDays": 7
    },
    {
      "id": "chrome-cache",
      "category": "浏览器",
      "name": "Chrome 网页缓存",
